#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

&soft_off {
    hold-time-ms = <2000>; // Only turn off it the key is held for 5 seconds or longer.
};

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "Default Layer";
                        bindings = <
                                &kp ESC         &kp N1          &kp N2          &kp N3          &kp N4          &kp N5                                                  &kp N6     &kp N7               &kp N8             &kp N9            &kp N0          &kp MINUS
                                &kp TAB         &kp Q           &kp W           &kp E           &kp R           &kp T                                                   &kp Y      &kp U                &kp I              &kp O             &kp P           &kp EQUAL
                                &kp LSHFT       &kp A           &kp S           &kp D           &kp F           &kp G                                                   &kp H      &kp J                &kp K              &kp L             &kp SEMI        &kp SQT
                                &kp LCTRL       &kp Z           &kp X           &kp C           &kp V           &kp B                                                   &kp N      &kp M                &kp COMMA          &kp DOT           &kp SLASH       &kp GRAVE
                                                                &kp LWIN        &kp LALT                                                                                                                &kp LBKT           &kp RBKT
                                                                                                                &kp BACKSPACE     &kp SPACE               &kp SPACE     &none
                                                                                                                &kp DEL           &kp RET                 &kp RET       &tog 3
                                                                                                                &kp PSCRN         &kp BSLH                &tog 1        &tog 2
                                        >;
                                };

                Lower_layer {
                        display-name = "Lower Layer";
                        bindings = <
                                &bt BT_CLR     &bt BT_SEL 1    &bt BT_SEL 2     &bt BT_SEL 3  	&bt BT_SEL 4     &bt BT_SEL 5                    	                    &none      &none 	            &kp KP_ASTERISK    &kp LPAR          &kp RPAR        &kp MINUS 
                                &bt BT_CLR_ALL &none           &none            &none 	        &none            &none                         	                        &none      &kp KP_NUMBER_7      &kp KP_NUMBER_8    &kp KP_NUMBER_9   &none           &kp KP_PLUS  
                                &kp LSHFT      &kp HOME        &kp PG_UP        &kp PG_DN       &kp END          &none                                                  &none      &kp KP_NUMBER_4      &kp KP_NUMBER_5    &kp KP_NUMBER_6   &none           &none  
                                &kp LCTRL      &none           &none            &none 	        &none            &none                        		                    &none 	   &kp KP_NUMBER_1      &kp KP_NUMBER_2    &kp KP_NUMBER_3   &kp KP_SLASH    &none  
                                                               &kp LWIN         &kp LALT            							                                                                        &kp KP_NUMBER_0    &kp KP_DOT 
                                                                                                                 &kp BACKSPACE    &kp SPACE               &kp SPACE     &none
                                                                                                                 &none            &kp RET                 &kp RET       &tog 3
                                                                                                                 &kp PSCRN        &kp BSLH                &tog 0        &tog 2
                                        >;
                                };

                Raise_layer {
                        display-name = "Raise Layer"; 
                        bindings = <
                                &kp F1 	        &kp F2          &kp F3    	    &kp F4          &kp F5      &kp F6                   		                            &kp F7     &kp F8               &kp F9             &kp F10            &kp F11        &kp F12 
                                &kp CAPS        &none           &kp UP          &none           &none       &none                    		                            &none      &kp PGUP             &kp INS            &none              &none          &none
                                &kp LSHFT       &kp LEFT        &kp DOWN  	    &kp RIGHT       &none       &none                    		                            &kp HOME   &kp PGDN             &kp DEL            &none              &none          &none
                                &kp LCTRL       &none           &none     	    &none           &none       &bootloader				                                    &kp END    &none                &none              &none              &none          &none
                                                                &kp LWIN        &kp LALT             			                  	                                                                    &none              &none
                                                                                                            &soft_off             &mo 1 	              &none         &none 
                                                                                                            &studio_unlock 	      &mo 2      	          &none         &tog 3 
                                                                                                            &none                 &none                   &tog 1        &tog 0		
                                        >;		

                                 };

                Game_layer {
                        display-name = "Game Layer"; 
                        bindings = <
                                &kp ESC         &kp N1          &kp N2          &kp N3          &kp N4      &kp N5                                                      &kp N6     &kp N7               &kp N8            &kp N9              &kp N0         &kp MINUS 
                                &kp TAB         &kp Q           &kp W           &kp E           &kp R       &kp T                                                       &kp Y      &kp U                &kp I             &kp O               &kp P          &kp EQUAL 
                                &kp LCTRL       &kp A           &kp S           &kp D           &kp F       &kp G                                                       &kp H      &kp J                &kp K             &kp L               &kp SEMI       &kp SQT 
                                &kp LSHFT       &kp Z           &kp X           &kp C           &kp V       &kp B                                                       &kp N      &kp M                &kp COMMA         &kp DOT             &kp SLASH      &kp RSHFT 
                                                                &kp LWIN        &kp LALT                                                        		                                                &none             &none 
                                                                                                            &kp BACKSPACE        &kp SPACE                &kp SPACE     &none
                                                                                                            &none                &kp RET                  &kp RET       &tog 0
                                                                                                            &kp PSCRN            &kp BSLH                 &tog 1        &tog 2		
                                        >;	
                                };
                };
};